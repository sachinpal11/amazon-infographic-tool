# Copy this file to .env.local and fill in the values.

# Claude API key (writes and reviews the prompts)
ANTHROPIC_API_KEY=

# Google Gemini API key (Nano Banana Pro image generation)
GEMINI_API_KEY=

# Shared password for the team. Leave empty to disable the login (local use only).
APP_PASSWORD=

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# IMAGE_SIZE=2K            # 1K, 2K or 4K
# DATA_DIR=./data          # where the database and images are stored
